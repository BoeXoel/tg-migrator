# ---- Telegram API (https://my.telegram.org) -------------------------------
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# ---- Control Bot (@BotFather) ----------------------------------------------
BOT_TOKEN=123456789:replace-with-your-bot-token
# Numeric Telegram user IDs allowed to control the Bot (comma separated).
# Everyone else is silently ignored.
ADMIN_IDS=11111111
# Optional: where notifications go (defaults to ADMIN_IDS).
# NOTIFY_CHAT_IDS=11111111

# true: the Bot uploads to Telegram targets (recommended).
# false: the logged-in user account both reads and writes, which enables
#        native copy/forward without downloading.
USE_BOT_AS_WRITER=true

# ---- Database ----------------------------------------------------------------
# Empty = SQLite at /app/data/migrator.db
# DATABASE_URL=postgresql+asyncpg://migrator:CHANGE_ME@postgres:5432/migrator
# DATABASE_URL=mysql+aiomysql://migrator:CHANGE_ME@mysql:3306/migrator
DATABASE_URL=
# Used by the optional compose database profiles
# POSTGRES_PASSWORD=CHANGE_ME
# MYSQL_PASSWORD=CHANGE_ME

# ---- Secret encryption -------------------------------------------------------
# Encrypts WebDAV passwords stored in the database. Empty = a key is generated
# once at /app/data/secret.key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# ---- Optional proxy ----------------------------------------------------------
# socks5://user:pass@host:1080  |  socks5h://host:1080  |  http://host:8080 (CONNECT)
# Internal addresses (localhost, 10/8, 172.16/12, 192.168/16, 100.64/10,
# Docker service names, *.local/*.lan/*.internal, NO_PROXY) always go direct.
PROXY_URL=
# Which traffic uses the proxy: telegram,webdav
PROXY_APPLY_TO=telegram,webdav
# Extra direct destinations: domains (suffix match) or CIDRs
NO_PROXY=
# Resolve WebDAV hostnames locally and go direct when they point to a LAN IP
PROXY_BYPASS_RESOLVE=true

# ---- Misc ------------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FILE=/app/data/migrator.log
TZ=Asia/Shanghai
# Container user (must own ./data ./sessions ./downloads ./archive)
PUID=1000
PGID=1000
